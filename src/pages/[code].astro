---
import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { useTranslations } from '../i18n';
import { normalizeCode } from '../shared/codes';
import { MAX_FILE_BYTES, MAX_ITEMS } from '../shared/limits';

const { lang } = Astro.locals;
const t = useTranslations(lang);
const raw = Astro.params.code ?? '';
const code = normalizeCode(raw);

// Kleinbuchstaben o. Ä. auf die kanonische Schreibweise umleiten
if (code && code !== raw) return Astro.redirect(`/${code}`, 301);

const info = code ? await env.ROOM.get(env.ROOM.idFromName(code)).info() : null;
const exists = info !== null;
const encrypted = info?.encrypted ?? false;
if (!exists) Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'no-store');
---

<Base title={exists ? `tee · ${code}` : `tee · ${t.room.titleNotFound}`} noindex>
  {
    !exists ? (
      <>
        <SiteHeader />
        <main class="notfound" id="main">
          <h1>{t.room.notFound}</h1>
          <p class="muted">{t.room.notFoundText}</p>
          <a class="btn btn-primary" href="/">
            {t.room.toHome}
          </a>
        </main>
        <SiteFooter />
      </>
    ) : (
      <>
        <SiteHeader compact>
          <span class="status" id="status" data-state="connecting" role="status">
            <span class="dot" />
            <span id="status-text">{t.room.connecting}</span>
          </span>
        </SiteHeader>
        <main class="room" id="main" data-code={code} data-max-file={MAX_FILE_BYTES} data-max-items={MAX_ITEMS} data-lang={lang} data-encrypted={encrypted ? '1' : '0'}>

        <h1 class="sr-only">{t.room.heading(code!)}</h1>

        <section class="card share">
          <div class="share-main">
            <div>
              <div class="muted label">{t.room.roomCode}</div>
              <button class="code mono" id="copy-link" title={t.room.copyLink} aria-label={t.room.copyLinkLabel(code!)}>
                {code}
              </button>
            </div>
            <button class="btn btn-small btn-ghost" id="toggle-qr" aria-expanded="false" aria-controls="qr-panel">
              {t.room.qr}
            </button>
          </div>
          <p class:list={['enc-badge', { plain: !encrypted }]}>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="4" y="11" width="16" height="10" rx="2" />
              {encrypted ? <path d="M8 11V7a4 4 0 0 1 8 0v4" /> : <path d="M8 11V7a4 4 0 0 1 7.5-2" />}
            </svg>
            <span>{encrypted ? t.room.encryptedBadge : t.room.plainBadge}</span>
          </p>
          <div class="qr-panel" id="qr-panel" hidden>
            <canvas id="qr" width="220" height="220" role="img" aria-label={t.room.qrLabel} />
            <p class="muted small mono" id="room-url" />
          </div>
        </section>

        <section class="card locked" id="locked" hidden>
          <h2>{t.room.lockedTitle}</h2>
          <p class="muted">{t.room.lockedText}</p>
          <form id="unlock" autocomplete="off">
            <label for="unlock-link" class="sr-only">{t.room.unlockLabel}</label>
            <input id="unlock-link" class="unlock-input mono" placeholder={t.room.unlockPlaceholder} required />
            <button class="btn btn-primary btn-small" type="submit">{t.room.unlock}</button>
          </form>
          <p class="error small" id="unlock-error" role="alert" hidden>{t.room.unlockInvalid}</p>
        </section>

        <div id="room-content">
        <section class="card composer">
          <label for="text" class="sr-only">
            {t.room.textLabel}
          </label>
          <textarea id="text" rows="3" placeholder={t.room.placeholder} />
          <div class="composer-actions">
            <input id="file" type="file" multiple class="sr-only file-input" />
            <label class="btn btn-small" for="file">
              <span aria-hidden="true">＋</span> {t.room.file}
            </label>
            <span class="muted small hint">{t.room.dropHint}</span>
            <button class="btn btn-primary btn-small" id="send">
              {t.room.send}
            </button>
          </div>
        </section>

        <ul class="uploads" id="uploads" />
        <div class="sr-only" id="announcer" aria-live="polite"></div>

        <div class="list-head">
          <h2>{t.room.items}</h2>
          <span class="muted small" id="count" />
        </div>
        <ul class="items" id="items" />
        <p class="empty muted" id="empty">
          {t.room.empty}
        </p>
        </div>
        <p class="muted small expiry" id="expiry" />

        <div class="dropzone" id="dropzone" hidden>
          <div>{t.room.dropzone}</div>
        </div>
        </main>
        <SiteFooter />
      </>
    )
  }
</Base>

<style>
  .notfound {
    text-align: center;
    padding-top: 14vh;
  }
  .room {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--muted);
    padding: 4px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--muted);
  }
  .status[data-state='online'] .dot {
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }
  .status[data-state='offline'] .dot {
    background: var(--danger);
  }
  .share-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .label {
    font-size: 13px;
  }
  .code {
    all: unset;
    cursor: pointer;
    font-family: var(--mono);
    font-size: 34px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--accent);
  }
  .qr-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
  }
  .qr-panel canvas {
    border-radius: 12px;
    background: #fff;
    width: 220px;
    height: 220px;
  }
  .small {
    font-size: 13px;
  }
  /* Gleiches Abstandsraster wie .room, auch innerhalb der Hülle */
  #room-content {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .enc-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 10px 0 0;
    font-size: 13px;
    color: var(--accent);
  }
  .enc-badge.plain {
    color: var(--muted);
  }
  .locked h2 {
    margin: 0 0 6px;
    font-size: 17px;
  }
  .locked p {
    margin: 0 0 12px;
  }
  #unlock {
    display: flex;
    gap: 8px;
  }
  .unlock-input {
    flex: 1;
    min-width: 0;
    min-height: 40px;
    padding: 0 12px;
    border: 1px solid var(--field-border);
    border-radius: 10px;
    background: var(--bg);
    font-size: 14px;
  }
  .locked .error {
    color: var(--danger);
    margin: 8px 0 0;
  }
  .composer textarea {
    width: 100%;
    resize: vertical;
    min-height: 84px;
    padding: 12px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg);
  }
  /* Das Dateifeld ist unsichtbar: Tastaturfokus am Button sichtbar machen */
  .file-input:focus-visible + label {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .composer-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
  }
  .composer-actions .hint {
    flex: 1;
  }
  @media (hover: none) {
    .composer-actions .hint {
      visibility: hidden;
    }
  }
  .uploads,
  .items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .list-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 8px;
  }
  .list-head h2 {
    margin: 0;
    font-size: 16px;
  }
  .empty {
    text-align: center;
    padding: 24px 0;
    margin: 0;
  }
  .expiry {
    text-align: center;
    margin: 8px 0 0;
  }
  .dropzone {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(4px);
    z-index: 50;
    pointer-events: none;
  }
  .dropzone div {
    padding: 40px 32px;
    border: 2px dashed var(--accent);
    border-radius: 20px;
    color: var(--accent);
    font-weight: 700;
    font-size: 18px;
  }

  /* Einträge werden per JS erzeugt → :global */
  .room :global(.item) {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    animation: pop 0.2s ease;
  }
  .room :global(.item-body) {
    min-width: 0;
  }
  .room :global(.item-text) {
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    max-height: 240px;
    overflow: auto;
    font-family: var(--sans);
  }
  .room :global(.item-link) {
    overflow-wrap: anywhere;
    font-weight: 600;
  }
  .room :global(.item-file) {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .room :global(.file-icon) {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--surface-2);
    font-size: 11px;
    font-weight: 700;
    font-family: var(--mono);
    color: var(--muted);
    text-transform: uppercase;
  }
  .room :global(.file-name) {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .room :global(.item-foot) {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .room :global(.item-foot .meta) {
    flex: 1;
    font-size: 12px;
    color: var(--muted);
  }
  .room :global(.btn-delete) {
    color: var(--muted);
  }
  .room :global(.upload) {
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    padding: 10px 14px;
    font-size: 14px;
  }
  .room :global(.upload progress) {
    width: 100%;
    height: 6px;
    accent-color: var(--accent);
  }
  .room :global(.upload.failed) {
    border-color: var(--danger);
    color: var(--danger);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
</style>

<script>
  import { initRoom } from '../scripts/room-client';
  const el = document.getElementById('main');
  if (el) initRoom(el);
</script>
