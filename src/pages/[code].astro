---
import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import { normalizeCode } from '../shared/codes';
import { MAX_FILE_BYTES, MAX_ITEMS } from '../shared/limits';

const raw = Astro.params.code ?? '';
const code = normalizeCode(raw);

// Kleinbuchstaben o. Ä. auf die kanonische Schreibweise umleiten
if (code && code !== raw) return Astro.redirect(`/${code}`, 301);

const exists = code ? await env.ROOM.get(env.ROOM.idFromName(code)).exists() : false;
if (!exists) Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'no-store');
---

<Base title={exists ? `Beam · ${code}` : 'Beam · Raum nicht gefunden'}>
  {
    !exists ? (
      <main class="notfound">
        <h1>Raum nicht gefunden</h1>
        <p class="muted">Der Code ist ungültig oder der Raum ist abgelaufen (24 h ohne Aktivität).</p>
        <a class="btn btn-primary" href="/">
          Zur Startseite
        </a>
      </main>
    ) : (
      <main class="room" id="room" data-code={code} data-max-file={MAX_FILE_BYTES} data-max-items={MAX_ITEMS}>
        <header class="top">
          <a href="/" class="brand" aria-label="Beam Startseite">
            Beam
          </a>
          <span class="status" id="status" data-state="connecting">
            <span class="dot" />
            <span id="status-text">Verbinde…</span>
          </span>
        </header>

        <section class="card share">
          <div class="share-main">
            <div>
              <div class="muted label">Raum-Code</div>
              <button class="code mono" id="copy-link" title="Link kopieren">
                {code}
              </button>
            </div>
            <button class="btn btn-small btn-ghost" id="toggle-qr" aria-expanded="false" aria-controls="qr-panel">
              QR-Code
            </button>
          </div>
          <div class="qr-panel" id="qr-panel" hidden>
            <canvas id="qr" width="220" height="220" aria-label="QR-Code zum Raum" />
            <p class="muted small mono" id="room-url" />
          </div>
        </section>

        <section class="card composer">
          <label for="text" class="sr-only">
            Text oder Link
          </label>
          <textarea id="text" rows="3" placeholder="Text oder Link einfügen…" />
          <div class="composer-actions">
            <label class="btn btn-small" for="file">
              <span aria-hidden="true">＋</span> Datei
            </label>
            <input id="file" type="file" multiple class="sr-only" />
            <span class="muted small hint">oder hierher ziehen</span>
            <button class="btn btn-primary btn-small" id="send">Senden</button>
          </div>
        </section>

        <ul class="uploads" id="uploads" />

        <div class="list-head">
          <h2>Einträge</h2>
          <span class="muted small" id="count" />
        </div>
        <ul class="items" id="items" />
        <p class="empty muted" id="empty">
          Noch nichts hier. Schick etwas von einem beliebigen Gerät.
        </p>
        <p class="muted small expiry" id="expiry" />

        <div class="dropzone" id="dropzone" hidden>
          <div>Dateien loslassen zum Senden</div>
        </div>
      </main>
    )
  }
</Base>

<style>
  .notfound {
    text-align: center;
    padding-top: 20vh;
  }
  .room {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    font-weight: 800;
    font-size: 20px;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--muted);
    padding: 4px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--muted);
  }
  .status[data-state='online'] .dot {
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }
  .status[data-state='offline'] .dot {
    background: var(--danger);
  }
  .share-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .code {
    all: unset;
    cursor: pointer;
    font-family: var(--mono);
    font-size: 34px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--accent);
  }
  .qr-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
  }
  .qr-panel canvas {
    border-radius: 12px;
    background: #fff;
    width: 220px;
    height: 220px;
  }
  .small {
    font-size: 13px;
  }
  .composer textarea {
    width: 100%;
    resize: vertical;
    min-height: 84px;
    padding: 12px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg);
  }
  .composer-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
  }
  .composer-actions .hint {
    flex: 1;
  }
  @media (hover: none) {
    .composer-actions .hint {
      visibility: hidden;
    }
  }
  .uploads,
  .items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .list-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 8px;
  }
  .list-head h2 {
    margin: 0;
    font-size: 16px;
  }
  .empty {
    text-align: center;
    padding: 24px 0;
    margin: 0;
  }
  .expiry {
    text-align: center;
    margin: 8px 0 0;
  }
  .dropzone {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(4px);
    z-index: 50;
    pointer-events: none;
  }
  .dropzone div {
    padding: 40px 32px;
    border: 2px dashed var(--accent);
    border-radius: 20px;
    color: var(--accent);
    font-weight: 700;
    font-size: 18px;
  }
  .dropzone[hidden] {
    display: none;
  }

  /* Einträge werden per JS erzeugt → :global */
  .room :global(.item) {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    animation: pop 0.2s ease;
  }
  .room :global(.item-body) {
    min-width: 0;
  }
  .room :global(.item-text) {
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    max-height: 240px;
    overflow: auto;
    font-family: var(--sans);
  }
  .room :global(.item-link) {
    overflow-wrap: anywhere;
    font-weight: 600;
  }
  .room :global(.item-file) {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .room :global(.file-icon) {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--surface-2);
    font-size: 11px;
    font-weight: 700;
    font-family: var(--mono);
    color: var(--muted);
    text-transform: uppercase;
  }
  .room :global(.file-name) {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .room :global(.item-foot) {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .room :global(.item-foot .meta) {
    flex: 1;
    font-size: 12px;
    color: var(--muted);
  }
  .room :global(.btn-delete) {
    color: var(--muted);
  }
  .room :global(.upload) {
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    padding: 10px 14px;
    font-size: 14px;
  }
  .room :global(.upload progress) {
    width: 100%;
    height: 6px;
    accent-color: var(--accent);
  }
  .room :global(.upload.failed) {
    border-color: var(--danger);
    color: var(--danger);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
</style>

<script>
  import { initRoom } from '../scripts/room-client';
  const el = document.getElementById('room');
  if (el) initRoom(el);
</script>
