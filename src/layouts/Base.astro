---
import '../styles/global.css';
import { useTranslations } from '../i18n';

interface Props {
  title?: string;
}
const { lang } = Astro.locals;
const t = useTranslations(lang);
const { title = t.meta.title } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0f1220" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f6fb" media="(prefers-color-scheme: light)" />
    <meta name="description" content={t.meta.description} />
    <slot name="head" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skipToContent}</a>
    <slot />
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
  </body>
</html>
