---
import '../styles/global.css';
import { useTranslations } from '../i18n';

interface Props {
  title?: string;
  /** Räume sind privat und kurzlebig: nicht in Suchmaschinen aufnehmen */
  noindex?: boolean;
}
const { lang } = Astro.locals;
const t = useTranslations(lang);
const { title = t.meta.title, noindex = false } = Astro.props;

// Vorschaubilder für geteilte Links (Open Graph / Twitter), pro Sprache
const site = Astro.site ?? Astro.url;
const pageUrl = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(`/og-${lang}.png`, site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0f1220" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f6fb" media="(prefers-color-scheme: light)" />
    <meta name="description" content={t.meta.description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="tee" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skipToContent}</a>
    <slot />
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
  </body>
</html>
