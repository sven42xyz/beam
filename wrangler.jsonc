{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beam",
  // Eigener Entrypoint: API-Routen + Astro-Handler + Export des Durable Objects
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Statische Assets (vom Astro-Build befüllt)
  "assets": { "binding": "ASSETS" },

  // Ein Durable Object pro Raum
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],

  // Dateien
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "beam-files" }],

  // Rate Limiting pro IP (period: 10 oder 60 Sekunden)
  "ratelimits": [
    {
      "name": "RL_CREATE",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "RL_WRITE",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    }
  ],

  // Turnstile (Raumerstellung). Leer = deaktiviert.
  // Secret: `wrangler secret put TURNSTILE_SECRET_KEY`. Lokal: .dev.vars (siehe .dev.vars.example)
  "vars": { "TURNSTILE_SITE_KEY": "" },

  // workers.dev-URLs für Produktion und Previews
  "workers_dev": true,
  "preview_urls": true,

  // Worker Previews (`wrangler preview`): Bindings werden nicht geerbt und müssen hier
  // erneut deklariert werden. Eigener Bucket + eigene Rate-Limit-Namespaces, damit
  // Preview-Daten nicht mit Produktion vermischt werden.
  "previews": {
    "vars": { "TURNSTILE_SITE_KEY": "" },
    "durable_objects": {
      "bindings": [{ "name": "ROOM", "class_name": "Room" }]
    },
    "r2_buckets": [{ "binding": "FILES", "bucket_name": "beam-files-preview" }],
    "ratelimits": [
      {
        "name": "RL_CREATE",
        "namespace_id": "2001",
        "simple": { "limit": 10, "period": 60 }
      },
      {
        "name": "RL_WRITE",
        "namespace_id": "2002",
        "simple": { "limit": 30, "period": 60 }
      }
    ]
  }
}
